# 复制为 .env 后填写真实值（.env 已被 git 忽略，切勿提交真实凭据）

# ---- 微伴助手 ----
corp_id=
secret=

# ---- 大模型（DeepSeek 兼容接口）----
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# ---- PostgreSQL ----
# docker-compose 用它替换容器口令；DATABASE_URL 是应用实际连接串，两者口令需一致
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://postgres:<password>@127.0.0.1:5433/weiban_chat

# ---- 浏览器（抓取企微正文凭据用；默认已适配 Windows 常见安装位置）----
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# BROWSER_PROFILE_DIR=%USERPROFILE%\.workbuddy\browser-profiles\wb-session
# CDP_PORT=9222
# 浏览器能力总开关：0 = 显式关闭（docker-compose 已在容器里设成 0）。
# 后端跑在容器里时，「扫码登录 / 保活」这类要开窗口的动作只能在宿主机执行：
# 双击 host_bootstrap_login.bat，产物落到 .cache/，容器会自动读到。
# BROWSER_ENABLED=0

# ---- 调度（分钟，0 = 关闭定时）----
SYNC_INTERVAL_MINUTES=0
KEEPALIVE_INTERVAL_MINUTES=360
SCORING_INTERVAL_MINUTES=0

# 日常任务（需求 4.2）：到点先同步、同步跑完自动接着分析。
# 留空 = 关闭该项；`.env` 里的值只是默认，运行时可在「同步中心 → 日常任务」里改（改完立即生效）。
SYNC_MAIN_CRON=20:00
SYNC_MAIN_WINDOW_MINUTES=20
SYNC_COMPENSATE_CRON=03:30
SYNC_COMPENSATE_LOOKBACK_HOURS=48
DAILY_RUN_ANALYSIS=true
# 增量同步的重叠回看窗口（分钟，需求 4.3）：start_time = 水位 − 该值，
# 兜住乱序/迟到入库的消息（重复由 PRIMARY KEY 幂等吸收）
SYNC_OVERLAP_MINUTES=15

# 登录会话（浏览器登录页；脚本/curl 仍可用 HTTP Basic）
# 勾「记住我」→ 该天数内免登录；不勾 → 浏览器会话 Cookie + 服务端 12 小时过期
SESSION_REMEMBER_DAYS=30
SESSION_HOURS=12

# ---- 评分范围与行为 ----
SCORING_MAX_SESSIONS=0
SCORING_MIN_MESSAGES=0
SCORING_FETCH_TAGS=true
SCORING_SLEEP_MS=0

# ---- 回写（dry_run = 只记录不真写；live = 真写微伴）----
SCORE_WRITEBACK=dry_run

# ---- 应用层鉴权（Basic Auth；首次启动若为空会自动生成并写入 .env）----
# 用户名默认 admin；密码留空则自动生成 20 位随机口令，启动日志打印一次
API_USER=admin
API_PASSWORD=
# API_AUTH=off   # 仅在「只绑 127.0.0.1 + 排障」时临时关闭，会打印警告

# ---- 多账号与角色（可选；配了它就走多账号，忽略上面的 API_USER/PASSWORD）----
# 格式：user:password:role，逗号分隔。role 四档（权限递增）：
#   viewer   只读
#   reviewer 可提交人工复核、标注评估集
#   operator 可发起任务、改运行时设置、执行需确认的回写
#   admin    全部，含审计导出 / 数据清理 / 规则发布 / 建标签
# ⚠️ 格式写错的条目会被**跳过**（不会静默提权成 admin）；启动日志会打印解析出的账号与角色。
# API_USERS=zhang:改成强口令:reviewer,li:改成强口令:operator,admin:改成强口令:admin

# ---- Policy 三档策略阈值（硬伤 4）----
# 置信度 ≥ auto 且无阻断原因 → 自动写；≥ confirm → 需二次确认；否则转人工。
# ⚠️ live 模式下这两个值是「机器能不能自己动手」的闸门，调宽前先看评估集指标。
# POLICY_AUTO_MIN=0.95
# POLICY_CONFIRM_MIN=0.80

# ---- 分层保留期（天；0 = 不清理）----
# 观测 30 / 幂等 7 / 审计 180 / 任务 90 是架构建议值，默认保守不删
# RETENTION_DAYS_OBSERVE=0
# RETENTION_DAYS_IDEMPOTENCY=7
# RETENTION_DAYS_AUDIT=0
# RETENTION_DAYS_TASK=0

# ---- Docker 部署（docker compose 用）----
# 备份周期与保留（backup 服务，--profile ops）
# BACKUP_INTERVAL_HOURS=24
# BACKUP_RETENTION_DAYS=14
