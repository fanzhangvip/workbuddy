# 复制为 .env 后填写真实值（.env 已被 git 忽略，切勿提交真实凭据）

# ---- 微伴助手 ----
corp_id=
secret=

# ---- 大模型（DeepSeek 兼容接口）----
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# ---- PostgreSQL ----
# docker-compose 用它替换容器口令；DATABASE_URL 是应用实际连接串，两者口令需一致
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://postgres:<password>@127.0.0.1:5433/weiban_chat

# ---- 浏览器（抓取企微正文凭据用；默认已适配 Windows 常见安装位置）----
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# BROWSER_PROFILE_DIR=%USERPROFILE%\.workbuddy\browser-profiles\wb-session
# CDP_PORT=9222

# ---- 调度（分钟，0 = 关闭定时）----
SYNC_INTERVAL_MINUTES=0
KEEPALIVE_INTERVAL_MINUTES=360
SCORING_INTERVAL_MINUTES=0

# ---- 评分范围与行为 ----
SCORING_MAX_SESSIONS=0
SCORING_MIN_MESSAGES=0
SCORING_FETCH_TAGS=true
SCORING_SLEEP_MS=0

# ---- 回写（dry_run = 只记录不真写；live = 真写微伴）----
SCORE_WRITEBACK=dry_run
