# ============================================================
# C:\zero\workbuddy —— 仓库根忽略规则
# 目标：排除依赖、构建产物、大体积二进制与本地临时文件，
#       其余源码与文档全部纳入版本库。
# ============================================================

# ---- Python 依赖 / 虚拟环境 ----
.venv/
venv/
ENV/
env/
.wheelcache/
*.egg-info/
.eggs/
.conda/

# ---- Python 缓存 ----
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---- Node / 前端依赖 ----
node_modules/
.pnpm-store/

# ---- 构建产物 ----
build/
dist/
build.old*/
dist.old*/
build.stale*/
dist.stale*/
*.old-*/

# ---- 本地工具与大型二进制（不适合进版本库）----
.tools/
*.dll
*.so
*.dylib
*.exe

# ---- 压缩归档（2026-10-17 清理后加）----
# ⚠️ 缘由：`workbuddy课程研发.zip`（1.43 GB）曾被提交并留在历史里，
#    导致 .git 涨到 1.5 GB（clone/push 极慢，且 GitHub 单文件 >100 MB 会被拒）。
#    已用 git-filter-repo 从历史彻底移除（.git 降至 7.8 MB）。
#    这里加规则**防止再次误提交**——归档包应走网盘/Release，不进源码库。
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
# 例外：确有需要的小体积归档，用 `git add -f` 显式强加，并在提交信息里说明原因。
!**/fixtures/**/*.zip

# ---- 本地临时 / 测试残留（skills 运行时产生，非源码）----
# 注意：中间带 "/" 的规则会被锚定到本文件所在目录，
#       要匹配任意层级必须加 **/ 前缀
**/.workbuddy/scratch-stale/
**/.workbuddy/scratch/
.stale-artifacts/
.verify/
.smoke-home/

# ---- 日志 / 临时文件 ----
*.log
*.tmp
.tmp*
*.bak
*.swp
*.spec.bak
stderr.txt
stdout.txt

# ---- 敏感配置：绝不进版本库 ----
.env
*.env
!*.env.example
!**/.env.example
env.py
secret.key
*token*
!scripts/*token*

# ---- IDE / 系统 ----
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
